{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'vixtormateus15@gmail.com')",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now && (!data.exists() || newData.val() === data.val())"
        },
        "$other": {
          ".validate": false
        }
      },
      ".read": "auth != null && auth.token.email === 'vixtormateus15@gmail.com'"
    },
    "wallets": {
