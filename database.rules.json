{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "profile": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "email": {
            ".validate": "newData.isString() && newData.val() === auth.token.email"
          },
          "displayName": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
