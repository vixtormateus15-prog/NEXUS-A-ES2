        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'vixtormateus15@gmail.com')",
        ".write": "auth != null && (auth.token.email === 'vixtormateus15@gmail.com' || (auth.uid === $uid && newData.exists() && newData.child('withdrawableBalance').isNumber() && newData.child('withdrawableBalance').val() === (data.exists() && data.child('withdrawableBalance').isNumber() ? data.child('withdrawableBalance').val() : 0) + 1 && newData.child('checkinCount').isNumber() && newData.child('checkinCount').val() === (data.exists() && data.child('checkinCount').isNumber() ? data.child('checkinCount').val() : 0) + 1 && newData.child('lastCheckinAt').isNumber() && newData.child('lastCheckinAt').val() <= now && newData.child('lastCheckinAt').val() >= now - 60000 && newData.child('depositBalance').val() === data.child('depositBalance').val() && newData.child('investments').val() === data.child('investments').val() && newData.child('investmentActivations').val() === data.child('investmentActivations').val() && newData.child('yieldCredits').val() === data.child('yieldCredits').val() && newData.child('depositCredits').val() === data.child('depositCredits').val() && newData.child('withdrawalReservations').val() === data.child('withdrawalReservations').val() && newData.child('withdrawalRefunds').val() === data.child('withdrawalRefunds').val() && (!data.exists() || !data.child('lastCheckinAt').exists() || data.child('lastCheckinAt').val() < now - ((now - 10800000) % 86400000))))",
        "withdrawableBalance": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        },
        "checkinCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "lastCheckinAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "depositBalance": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        },
        "depositCredits": {
          ".validate": "newData.hasChildren()"
        },
        "$other": {
          ".validate": true
        }
      },
      ".read": "auth != null && auth.token.email === 'vixtormateus15@gmail.com'"
    },
