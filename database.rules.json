{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'vixtormateus15@gmail.com')",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        "email": { ".validate": "newData.isString() && newData.val() === auth.token.email" },
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now && (!data.exists() || newData.val() === data.val())" },
        "$other": { ".validate": false }
      }
    },
    "wallets": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'vixtormateus15@gmail.com')",
        ".write": "auth != null && auth.uid === $uid && newData.exists() && newData.child('withdrawableBalance').isNumber() && newData.child('withdrawableBalance').val() === (data.exists() && data.child('withdrawableBalance').isNumber() ? data.child('withdrawableBalance').val() : 0) + 1 && newData.child('checkinCount').isNumber() && newData.child('checkinCount').val() === (data.exists() && data.child('checkinCount').isNumber() ? data.child('checkinCount').val() : 0) + 1 && newData.child('lastCheckinAt').isNumber() && newData.child('lastCheckinAt').val() <= now && newData.child('lastCheckinAt').val() >= now - 60000 && (!data.exists() || !data.child('lastCheckinAt').exists() || data.child('lastCheckinAt').val() < now - ((now - 10800000) % 86400000))",
        "withdrawableBalance": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000000" },
        "checkinCount": { ".validate": "newData.isNumber() && newData.val() >= 1" },
        "lastCheckinAt": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000" },
        "$other": { ".validate": false }
      }
    },
    "transactions": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false } },
    "withdrawalRequests": {
      ".read": "auth != null && auth.token.email === 'vixtormateus15@gmail.com'",
      "$requestId": {
        ".read": "auth != null && (auth.token.email === 'vixtormateus15@gmail.com' || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && (auth.token.email === 'vixtormateus15@gmail.com' || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending'))",
        ".validate": "newData.hasChildren(['uid','amount','pixKey','status','createdAt'])",
        "uid": { ".validate": "newData.isString() && newData.val().length > 0" },
        "amount": { ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 100000" },
        "pixKey": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'paid' || newData.val() === 'rejected'" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": true }
      }
    }
  }
}